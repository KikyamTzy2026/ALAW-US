{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": true,
        "players": {
          "$playerId": {
            ".validate": "newData.hasChildren(['username', 'color', 'avatar', 'x', 'y', 'alive', 'ready'])"
          }
        },
        "host": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.isString()"
        }
      }
    }
  }
}
